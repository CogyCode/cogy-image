# Settings for join-network.sh, install.sh, uninstall.sh and the scripts.
# Read by the shell scripts (sourced) and by the Python scripts (KEY=value
# lines, # comments). Nothing here is machine-specific: the private address
# is discovered from Tailscale at install time and the join key is given when
# joining.

# Project
NAME='Cogy Image'
ROLE='screenshot and image reader for the Cogy system'

# systemd units, service user and nftables table.
# SERVICE_NAME runs the image service (image/image.py) on PORT; it uses the
# model server (GenieX), which listens on 127.0.0.1:MODEL_PORT only.
SERVICE_NAME='cogy-image'
MODEL_SERVICE_NAME='cogy-image-model'
FIREWALL_SERVICE_NAME='cogy-image-firewall'
SERVICE_USER='cogy-image'
NFT_TABLE='cogy_image'

# Install locations
INSTALL_DIR='/opt/cogy-image'       # GenieX and the image service
CONFIG_DIR='/etc/cogy-image'        # image.json, firewall rules
STATE_DIR='/var/lib/cogy-image'     # the service user's home: GenieX's model store
LOG_DIR='/var/log/cogy-image'

# API
PORT=8812
MODEL_PORT=18812
# Who may call the API: addresses or CIDR ranges, space-separated. Cogy Code
# sends screenshots to Cogy Server (POST /api/images/inspect), and Cogy Server
# sends them here, so only Cogy Server is admitted. Set it to Cogy Server's
# private address before installing, for example '<cogy-server-address>'.
ALLOW_FROM=''
PRIVATE_RANGE='100.64.0.0/10'       # address range of the private network

# GenieX (Qualcomm's on-device runtime), Linux ARM64 CLI with the QAIRT plugin.
# v0.12.0 bundles QAIRT 2.51, the version the model bundle below is compiled
# with; GenieX releases with an older QAIRT cannot load it ("Create From
# Binary FAILED"). GENIEX_SHA256 is the release tarball's, as published in the
# .sha256 file next to it.
GENIEX_VERSION='v0.12.0'
GENIEX_URL='https://qaihub-public-assets.s3.us-west-2.amazonaws.com/qai-hub-geniex/geniex-cli-linux-arm64-v0.12.0.tar.gz'
GENIEX_SHA256='ae9b616cfc28b8a245479e74fb1befb63f5b33bc8cd1a6d95c83b8bedc2a19fd'

# Model: Qwen3-VL-4B-Instruct, w4a16, precompiled by Qualcomm AI Hub (release
# v0.67.0, QAIRT 2.51) for the QCS8275 (Dragonwing IQ8, Hexagon v75). About
# 3.0 GB. MODEL_NAME is its name in GenieX's model store and in API requests.
MODEL_NAME='qualcomm/Qwen3-VL-4B-Instruct'
MODEL_URL='https://qaihub-public-assets.s3.us-west-2.amazonaws.com/qai-hub-models/models/qwen3_vl_4b_instruct/releases/v0.67.0/qwen3_vl_4b_instruct-geniex_qairt-w4a16-qualcomm_qcs8275.zip'
MODEL_SHA256='e32a81cf230f2eae04f3a63d280d5953137e89b0a4a0572ac7f80ef8e2fff40d'
MODEL_CHIPSET='QCS8275'

# Fixed by the model bundle (it is compiled for them); used by the checks.
CONTEXT_LENGTH=4096                 # per request: prompt (with the image) plus output
IMAGE_SIZE=512                      # every image is resized to 512 x 512 (256 image tokens)

MAX_TOKENS=1200                     # per inspection
REQUEST_TIMEOUT=300                 # seconds the image service waits for the model server
MAX_IMAGE_BYTES=10485760            # 10 MB, the limit Cogy Code applies

# NPU clock mode: low_power_saver, power_saver, high_power_saver,
# low_balanced, balanced, high_performance, sustained_high_performance, burst
POWER_MODE='burst'

# Tailscale (installed by join-network.sh when missing), from its signed apt
# repository; the signing key's fingerprint is checked before it is trusted.
TAILSCALE_REPO='https://pkgs.tailscale.com/stable'
TAILSCALE_KEY_FINGERPRINT='2596A99EAAB33821893C0A79458CA832957F5868'
